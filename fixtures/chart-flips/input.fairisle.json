{
  "format": "fairisle-pattern",
  "version": 1,
  "meta": { "name": "Flips" },
  "gauge": { "stitches": 28, "rows": 32, "per_cm": 10 },
  "cast_on": 4,
  "settings": { "float_notice": 5, "float_warning": 8, "max_colors_per_row": 2, "min_contrast": 15 },
  "palette": [
    { "id": "a", "hex": "#f2efe8" },
    { "id": "b", "hex": "#24283b" },
    { "id": "c", "hex": "#8a1c1c" },
    { "id": "d", "hex": "#1f5f3a" }
  ],
  "motifs": [
    { "id": "hook", "rows": [
      "1000",
      "1100",
      "0010"
    ], "mappings": [
      { "id": "rows", "colors": ["a", "b", "c", "d"], "rows": [
        "01",
        "02",
        "03"
      ] }
    ] }
  ],
  "bands": [
    { "motif": "hook", "mapping": "rows", "offset": 0 },
    { "motif": "hook", "mapping": "rows", "offset": 0, "flip_horizontal": true },
    { "motif": "hook", "mapping": "rows", "offset": 0, "flip_vertical": true },
    { "motif": "hook", "mapping": "rows", "offset": 0, "flip_horizontal": true, "flip_vertical": true },
    { "motif": "hook", "mapping": "rows", "offset": 1, "flip_horizontal": true },
    { "motif": "hook", "mapping": "rows", "offset": 0, "times": 2, "flip_vertical": true }
  ]
}
